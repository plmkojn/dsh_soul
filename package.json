{
  "name": "dsh-soul",
  "version": "0.1.0",
  "private": false,
  "description": "A persistent AI companion for DeepSeek Harness with moods, memories, switchable personas, per-persona diaries, and a chat panel. No local computer control.",
  "license": "MIT",
  "author": "dsh-soul contributors",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "pet/pet-window.ps1",
    "DEPLOY.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "ai-companion",
    "persona",
    "chatbot"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
